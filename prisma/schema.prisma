// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth için gerekli modeller
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Credentials provider için şifre
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Çalışanlar Tablosu
model Calisan {
  id              Int       @id @default(autoincrement())
  isim            String?   @db.VarChar(100)
  soyisim         String?   @db.VarChar(100)
  departman       String?   @db.VarChar(100)
  tcNo            String?   @unique @db.VarChar(20) @map("tc_no")
  dogumTarihi     DateTime? @map("dogum_tarihi") @db.Date
  telNo           String?   @db.VarChar(20) @map("tel_no")
  adres           String?   @db.Text
  anneAdi         String?   @db.VarChar(100) @map("anne_adi")
  babaAdi         String?   @db.VarChar(100) @map("baba_adi")
  medeniDurum     String?   @db.VarChar(50) @map("medeni_durum")
  cocuk           Int       @default(0)
  kanGrubu        String?   @db.VarChar(10) @map("kan_grubu")
  email           String    @unique @db.VarChar(255)
  egitimDurum     String?   @db.VarChar(100) @map("egitim_durum")
  acilIletisim    String?   @db.VarChar(100) @map("acil_iletisim")
  acilIletisimTel String?   @db.VarChar(20) @map("acil_iletisim_tel")
  sgkSicilNo      String?   @db.VarChar(50) @map("sgk_sicil_no")
  bankaAdi        String?   @db.VarChar(100) @map("banka_adi")
  iban            String?   @db.VarChar(34)
  iseGirisTarihi  DateTime? @map("ise_giris_tarihi") @db.Date
  istenCikisTarihi DateTime? @map("isten_cikis_tarihi") @db.Date
  password        String    @db.VarChar(255)
  ekstra1         String?   @db.VarChar(255) @map("ekstra_1")
  ekstra2         String?   @db.VarChar(255) @map("ekstra_2")
  ekstra3         String?   @db.VarChar(255) @map("ekstra_3")
  /// Supabase storage path (bucket-relative), örn. calisan-avatars/12/uuid.jpg
  profilFotoStoragePath String? @map("profil_foto_storage_path") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  announcements Announcement[]
  updatedAt       DateTime  @updatedAt @map("updated_at")
  hazardReports            HazardReport[]
  incomingPapers           IncomingPaper[]
  outgoingCorrespondences  OutgoingCorrespondence[]
  meetingParticipations    MeetingParticipant[]
  meetingTasksAssigned     MeetingTask[]          @relation("MeetingTaskAssignee")
  aircraftDocumentsUploaded AircraftDocument[]    @relation("AircraftDocumentUploader")
  taskMessages TaskMessage[]
  taskAttachmentsUploaded TaskAttachment[]
  dmMessagesSent DmMessage[]      @relation("DmMessageSender")
  dmReadStates   DmReadState[]
  workerRegistrationsReviewed WorkerRegistrationRequest[] @relation("WorkerRegistrationReviewedBy")
  announcementAcknowledgments AnnouncementAcknowledgment[]
  companyManuals CompanyManual[]
  safetyRiskBoardsUpdated   SafetyRiskBoard[] @relation("SafetyRiskBoardUpdatedBy")

  @@index([createdAt(sort: Desc)])
  @@index([isim, soyisim])
  @@map("calisanlar")
}

enum WorkerRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Self-service registration; admins approve into `Calisan`.
model WorkerRegistrationRequest {
  id              Int                      @id @default(autoincrement())
  status          WorkerRegistrationStatus @default(PENDING)
  isim            String?                  @db.VarChar(100)
  soyisim         String?                  @db.VarChar(100)
  departman       String?                  @db.VarChar(100)
  tcNo            String?                  @map("tc_no") @db.VarChar(20)
  dogumTarihi     DateTime?                @map("dogum_tarihi") @db.Date
  telNo           String?                  @map("tel_no") @db.VarChar(20)
  adres           String?                  @db.Text
  anneAdi         String?                  @map("anne_adi") @db.VarChar(100)
  babaAdi         String?                  @map("baba_adi") @db.VarChar(100)
  medeniDurum     String?                  @map("medeni_durum") @db.VarChar(50)
  cocuk           Int                      @default(0)
  kanGrubu        String?                  @map("kan_grubu") @db.VarChar(10)
  email           String                   @db.VarChar(255)
  egitimDurum     String?                  @map("egitim_durum") @db.VarChar(100)
  acilIletisim    String?                  @map("acil_iletisim") @db.VarChar(100)
  acilIletisimTel String?                  @map("acil_iletisim_tel") @db.VarChar(20)
  sgkSicilNo      String?                  @map("sgk_sicil_no") @db.VarChar(50)
  bankaAdi        String?                  @map("banka_adi") @db.VarChar(100)
  iban            String?                  @db.VarChar(34)
  iseGirisTarihi  DateTime?                @map("ise_giris_tarihi") @db.Date
  istenCikisTarihi DateTime?               @map("isten_cikis_tarihi") @db.Date
  password        String                   @db.VarChar(255)
  ekstra1         String?                  @map("ekstra_1") @db.VarChar(255)
  ekstra2         String?                  @map("ekstra_2") @db.VarChar(255)
  ekstra3         String?                  @map("ekstra_3") @db.VarChar(255)
  profilFotoStoragePath String?            @map("profil_foto_storage_path") @db.Text
  reviewedAt            DateTime?          @map("reviewed_at")
  reviewedByCalisanId   Int?               @map("reviewed_by_calisan_id")
  rejectionReason       String?            @map("rejection_reason") @db.Text
  approvedCalisanId     Int?               @map("approved_calisan_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  reviewedBy Calisan? @relation("WorkerRegistrationReviewedBy", fields: [reviewedByCalisanId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@map("worker_registration_requests")
}

// Çalışanlar arası doğrudan mesajlaşma (1:1)
model DmConversation {
  id           Int      @id @default(autoincrement())
  lowerUserId  Int      @map("lower_user_id")
  higherUserId Int      @map("higher_user_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  messages   DmMessage[]
  readStates DmReadState[]

  @@unique([lowerUserId, higherUserId])
  @@index([lowerUserId])
  @@index([higherUserId])
  @@index([updatedAt(sort: Desc)])
  @@map("dm_conversations")
}

model DmMessage {
  id                   Int      @id @default(autoincrement())
  conversationId       Int      @map("conversation_id")
  senderId             Int      @map("sender_id")
  body                 String   @default("") @db.Text
  attachmentPath       String?  @map("attachment_path") @db.VarChar(1000)
  attachmentFileName   String?  @map("attachment_file_name") @db.VarChar(255)
  attachmentMime       String?  @map("attachment_mime") @db.VarChar(200)
  attachmentSize       Int?     @map("attachment_size")
  attachmentPublicUrl  String?  @map("attachment_public_url") @db.VarChar(2000)
  createdAt            DateTime @default(now()) @map("created_at")

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Calisan        @relation("DmMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@map("dm_messages")
}

model DmReadState {
  id                Int      @id @default(autoincrement())
  conversationId    Int      @map("conversation_id")
  calisanId         Int      @map("calisan_id")
  lastReadMessageId Int?     @map("last_read_message_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  calisan      Calisan        @relation(fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([conversationId, calisanId])
  @@index([calisanId])
  @@map("dm_read_states")
}

// Hazard Reports Tablosu
model HazardReport {
  id              Int       @id @default(autoincrement())
  reportNo        String?   @unique @map("report_no") @db.VarChar(50)
  eventDate       DateTime  @map("event_date") @db.Date
  sourceType      String?   @map("source_type") @db.VarChar(100)
  isAnonymous     Boolean   @default(false) @map("is_anonymous")
  title           String?   @db.VarChar(500)
  details         String?   @db.Text
  reportedBy      Int?      @map("reported_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  reporter     Calisan?            @relation(fields: [reportedBy], references: [id], onDelete: Cascade)
  attachments  HazardAttachment[]

  @@index([createdAt(sort: Desc)])
  @@index([reportedBy])
  @@map("hazard_reports")
}

model HazardAttachment {
  id             Int      @id @default(autoincrement())
  hazardReportId Int      @map("hazard_report_id")
  storagePath    String   @map("storage_path") @db.VarChar(1000)
  fileName       String   @map("file_name") @db.VarChar(255)
  externalParticipants   String?   @map("external_participants") @db.Text
  mimeType       String   @map("mime_type") @db.VarChar(200)
  kind           String   @db.VarChar(20)
  publicUrl      String   @map("public_url") @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")

  hazardReport HazardReport @relation(fields: [hazardReportId], references: [id], onDelete: Cascade)

  @@index([hazardReportId])
  @@map("hazard_attachments")
}

// Incoming Correspondences Tablosu
model IncomingPaper {
  id              Int       @id @default(autoincrement())
  paperNo         String?   @unique @map("paper_no") @db.VarChar(50)
  from            String?   @db.VarChar(255)
  subject         String?   @db.VarChar(500)
  date            DateTime  @map("date") @db.Date
  content         String?   @db.Text
  pdfPath         String?   @map("pdf_path") @db.VarChar(500)
  pdfFileName     String?   @map("pdf_file_name") @db.VarChar(255)
  /// [{ "path": "BON-IP-001/file.pdf", "fileName": "file.pdf" }, ...]
  pdfAttachments  Json?     @map("pdf_attachments")
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator Calisan? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([createdBy])
  @@map("incoming_papers")
}

// Outgoing Correspondences Tablosu
model OutgoingCorrespondence {
  id              Int       @id @default(autoincrement())
  paperNo         String?   @unique @map("paper_no") @db.VarChar(50)
  to              String?   @db.VarChar(255)
  subject         String?   @db.VarChar(500)
  date            DateTime  @map("date") @db.Date
  content         String?   @db.Text
  pdfPath         String?   @map("pdf_path") @db.VarChar(500)
  pdfFileName     String?   @map("pdf_file_name") @db.VarChar(255)
  /// [{ "path": "outgoing/BON-OC-001/file.pdf", "fileName": "file.pdf" }, ...]
  pdfAttachments  Json?     @map("pdf_attachments")
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator Calisan? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([createdBy])
  @@map("outgoing_correspondences")
}

// Uçaklar Tablosu
model Ucaklar {
  id         Int                 @id @default(autoincrement())
  register   String              @db.VarChar(100)
  msn        String              @db.VarChar(100)
  isArchived Boolean             @default(false) @map("is_archived")
  documents  AircraftDocument[]

  @@index([isArchived])
  @@map("ucaklar")
}

model AircraftDocument {
  id          Int       @id @default(autoincrement())
  aircraftId  Int       @map("aircraft_id")
  category    String    @db.VarChar(50)
  docType     String    @map("doc_type") @db.VarChar(200)
  fileName    String    @map("file_name") @db.VarChar(255)
  storagePath String    @map("storage_path") @db.VarChar(1000)
  fileSize    Int?      @map("file_size")
  validFrom   DateTime? @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  isArchived  Boolean   @default(false) @map("is_archived")
  uploadedBy  Int?      @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  aircraft Ucaklar @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  uploader Calisan? @relation("AircraftDocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([aircraftId])
  @@map("aircraft_documents")
}

// Toplantı türleri (Supabase’te mevcut tablo: bigint id, text name, created_at)
model MeetingType {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.Text
  // Short code for numbers: TOPL-2026-001
  code      String   @default("TOPL") @db.VarChar(20) @map("code")
  createdAt DateTime @default(now()) @map("created_at")
  meetings  Meeting[]

  @@map("meeting_types")
}

// Toplantılar
model Meeting {
  id              Int       @id @default(autoincrement())
  meetingNo       String    @unique @map("meeting_no") @db.VarChar(50)
  title           String    @db.VarChar(500)
  plannedDate     DateTime  @map("planned_date") @db.Date
  initializedDate DateTime? @map("initialized_date")
  isOnline        Boolean   @default(false) @map("is_online")
  agenda          String?   @db.Text
  meetingTypeId   BigInt?   @map("meeting_type_id")
  status          String    @default("Planned") @db.VarChar(50)
  meetingMinutes  String?   @map("meeting_minutes") @db.Text
  actualDate      DateTime? @map("actual_date") @db.Date
  filePath        String?   @map("file_path") @db.VarChar(1000)
  fileName        String?   @map("file_name") @db.VarChar(255)
  externalParticipants String? @map("external_participants") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  meetingType  MeetingType?           @relation(fields: [meetingTypeId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  tasks        MeetingTask[]

  @@index([plannedDate])
  @@map("meetings")
}

model MeetingParticipant {
  id        Int @id @default(autoincrement())
  meetingId Int @map("meeting_id")
  calisanId Int @map("calisan_id")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  calisan Calisan @relation(fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([meetingId, calisanId])
  @@index([meetingId])
  @@index([calisanId])
  @@map("meeting_participants")
}

model MeetingTask {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(500)
  status     String    @default("Open") @db.VarChar(50)
  dueDate    DateTime? @map("due_date") @db.Date
  meetingId  Int       @map("meeting_id")
  assigneeId Int?      @map("assignee_id")
  filePath   String?   @map("file_path") @db.VarChar(1000)
  fileName   String?   @map("file_name") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  messages TaskMessage[]

  meeting  Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee Calisan? @relation("MeetingTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@index([meetingId])
  @@index([assigneeId])
  @@index([createdAt(sort: Desc)])
  @@map("meeting_tasks")
}


// Duyurular Tablosu
model Announcement {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(500)
  content     String    @db.Text
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator Calisan? @relation(fields: [createdBy], references: [id])
  acknowledgments AnnouncementAcknowledgment[]

  @@index([createdAt(sort: Desc)])
  @@index([createdBy])
  @@map("announcements")
}

/// Çalışanın duyuruyu “okudum, anladım” ile onayladığı kayıt
model AnnouncementAcknowledgment {
  id             Int      @id @default(autoincrement())
  announcementId Int      @map("announcement_id")
  calisanId      Int      @map("calisan_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  calisan      Calisan      @relation(fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([announcementId, calisanId])
  @@index([calisanId])
  @@index([announcementId])
  @@map("announcement_acknowledgments")
}

/// AI sohbette referans için yüklenen şirket manueli (PDF’ten çıkarılmış metin)
model CompanyManual {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(300)
  slug        String   @unique @db.VarChar(160)
  contentText String   @map("content_text") @db.Text
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator Calisan? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([title])
  @@map("company_manuals")
}

model TaskMessage {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  senderId  Int?     @map("sender_id")
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task   MeetingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender Calisan?    @relation(fields: [senderId], references: [id])

  @@index([taskId])
  @@map("task_messages")
}
model TaskAttachment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  fileName  String   @db.VarChar(255) @map("file_name")
  filePath  String   @db.VarChar(500) @map("file_path")
  fileSize  Int?     @map("file_size")
  fileType  String?  @db.VarChar(100) @map("file_type")
  uploadedBy Int?    @map("uploaded_by")
  createdAt DateTime @default(now()) @map("created_at")

  task     MeetingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader Calisan?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_attachments")
}

/// Task board / bow-tie: kurum genelinde risk başına tek paylaşımlı kayıt.
model SafetyRiskBoard {
  id                  String   @id @default(cuid())
  /// Başlıktan türetilen sabit anahtar (max 600 karakter)
  riskKey             String   @unique @map("risk_key") @db.VarChar(600)
  /// Tam risk / olay başlığı (görüntü)
  riskTitle           String   @map("risk_title") @db.Text
  probability         Int?
  severity            String?  @db.VarChar(1)
  threats             Json
  consequences        Json
  threatOpenById      Json     @map("threat_open_by_id")
  consequenceOpenById Json     @map("consequence_open_by_id")
  updatedByCalisanId  Int?     @map("updated_by_calisan_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  updatedBy Calisan? @relation("SafetyRiskBoardUpdatedBy", fields: [updatedByCalisanId], references: [id], onDelete: SetNull)

  @@index([updatedAt(sort: Desc)])
  @@map("safety_risk_boards")
}
