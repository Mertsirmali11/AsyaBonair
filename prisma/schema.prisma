// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth için gerekli modeller
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Credentials provider için şifre
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Çalışanlar Tablosu
model Calisan {
  id              Int       @id @default(autoincrement())
  isim            String?   @db.VarChar(100)
  soyisim         String?   @db.VarChar(100)
  departman       String?   @db.VarChar(100)
  /// Çalışanın unvanı (DepartmentTitle FK — opsiyonel)
  titleId         Int?      @map("title_id")
  /// Çalışanın mevcut fiziksel konumu (Ofis/Hangar/Remote/Saha/Görevde). İzin varsa otomatik "OnLeave".
  workLocation    String?   @default("Office") @map("work_location") @db.VarChar(50)
  /// Çalışanın durumu için seçtiği tarih (opsiyonel, görevde/saha için kullanılır)
  workLocationDate DateTime? @map("work_location_date") @db.Date
  /// Konum tarih aralığının bitiş günü (başlangıçtan farklıysa)
  workLocationDateEnd DateTime? @map("work_location_date_end") @db.Date
  tcNo            String?   @unique @db.VarChar(20) @map("tc_no")
  dogumTarihi     DateTime? @map("dogum_tarihi") @db.Date
  telNo           String?   @db.VarChar(20) @map("tel_no")
  adres           String?   @db.Text
  anneAdi         String?   @db.VarChar(100) @map("anne_adi")
  babaAdi         String?   @db.VarChar(100) @map("baba_adi")
  medeniDurum     String?   @db.VarChar(50) @map("medeni_durum")
  cocuk           Int       @default(0)
  kanGrubu        String?   @db.VarChar(10) @map("kan_grubu")
  email           String    @unique @db.VarChar(255)
  egitimDurum     String?   @db.VarChar(100) @map("egitim_durum")
  acilIletisim    String?   @db.VarChar(100) @map("acil_iletisim")
  acilIletisimTel String?   @db.VarChar(20) @map("acil_iletisim_tel")
  sgkSicilNo      String?   @db.VarChar(50) @map("sgk_sicil_no")
  bankaAdi        String?   @db.VarChar(100) @map("banka_adi")
  iban            String?   @db.VarChar(34)
  iseGirisTarihi  DateTime? @map("ise_giris_tarihi") @db.Date
  istenCikisTarihi DateTime? @map("isten_cikis_tarihi") @db.Date
  password        String    @db.VarChar(255)
  ekstra1         String?   @db.VarChar(255) @map("ekstra_1")
  ekstra2         String?   @db.VarChar(255) @map("ekstra_2")
  ekstra3         String?   @db.VarChar(255) @map("ekstra_3")
  /// Supabase storage path (bucket-relative), örn. calisan-avatars/12/uuid.jpg
  profilFotoStoragePath String? @map("profil_foto_storage_path") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  announcements Announcement[]
  updatedAt       DateTime  @updatedAt @map("updated_at")
  hazardReports            HazardReport[]
  incomingPapers           IncomingPaper[]
  outgoingCorrespondences  OutgoingCorrespondence[]
  meetingParticipations    MeetingParticipant[]
  meetingTasksAssigned     MeetingTask[]          @relation("MeetingTaskAssignee")
  meetingTasksAssignedBy   MeetingTask[]          @relation("MeetingTaskAssignedBy")
  aircraftDocumentsUploaded AircraftDocument[]    @relation("AircraftDocumentUploader")
  taskMessages TaskMessage[]
  taskAttachmentsUploaded TaskAttachment[]
  dmMessagesSent DmMessage[]      @relation("DmMessageSender")
  dmReadStates   DmReadState[]
  dmConversationMembers DmConversationMember[]
  workerRegistrationsReviewed WorkerRegistrationRequest[] @relation("WorkerRegistrationReviewedBy")
  announcementAcknowledgments AnnouncementAcknowledgment[]
  companyManuals CompanyManual[]
  departmentFormsCreated    DepartmentForm[]           @relation("DepartmentFormCreator")
  departmentProceduresCreated DepartmentProcedure[]    @relation("DepartmentProcedureCreator")
  documentProcedureVersions DocumentProcedureVersion[] @relation("DocumentProcedureCreator")
  safetyRiskBoardsUpdated   SafetyRiskBoard[] @relation("SafetyRiskBoardUpdatedBy")
  auditPlanAuditors AuditPlanAuditor[] @relation("AuditPlanAuditorCalisan")
  auditPlanAuditees AuditPlanAuditee[] @relation("AuditPlanAuditeeCalisan")
  auditFindingsAssigned   AuditFinding[]           @relation("AuditFindingAssignee")
  auditFindingResponses   AuditFindingResponse[]   @relation("AuditFindingResponder")
  auditFindingExtensions  AuditFindingExtension[]  @relation("AuditFindingExtensionRequester")
  supportTicketsCreated SupportTicket[] @relation("SupportTicketCreator")
  supportTicketsAdminUpdated SupportTicket[] @relation("SupportTicketAdmin")
  supportTicketHistoryActions SupportTicketHistory[] @relation("SupportTicketHistoryActor")
  companyStatusLogs CompanyStatusLog[]
  /// Unvan ilişkisi
  title           DepartmentTitle? @relation(fields: [titleId], references: [id], onDelete: SetNull)
  /// İzin talepleri — çalışan olarak
  leaveRequestsAsEmployee  LeaveRequest[] @relation("LeaveEmployee")
  /// İzin talepleri — onaylayıcı olarak
  leaveRequestsAsApprover  LeaveRequest[] @relation("LeaveApprover")
  trainingRecords          TrainingRecord[]        @relation("TrainingRecordCalisan")
  trainingRecordsCreated   TrainingRecord[]        @relation("TrainingRecordCreator")
  auditPlanDocumentsUploaded AuditPlanDocument[]   @relation("AuditPlanDocumentUploader")
  auditPlanEntryHistoryActions AuditPlanEntryHistory[] @relation("AuditPlanEntryHistoryActor")
  auditFindingFilesUploaded AuditFindingFile[] @relation("AuditFindingFileUploader")
  auditFindingHistoryActions AuditFindingHistory[] @relation("AuditFindingHistoryActor")
  auditResponseLinksCreated AuditResponseLink[] @relation("AuditResponseLinkCreator")
  auditResponseNotesSubmitted AuditResponseNote[] @relation("AuditResponseNoteSubmitter")
  auditeeChecklistSubmissionsSubmitted AuditeeChecklistSubmission[] @relation("AuditeeChecklistSubmissionSubmitter")
  auditeeChecklistSubmissionsReviewed AuditeeChecklistSubmission[] @relation("AuditeeChecklistSubmissionReviewer")
  plannerPlansCreated PlannerPlan[] @relation("PlannerPlanCreator")
  plannerPlanMemberships PlannerPlanMember[] @relation("PlannerPlanMemberCalisan")
  plannerTasksCreated PlannerTask[] @relation("PlannerTaskCreator")
  plannerTaskAssignments PlannerTaskAssignee[] @relation("PlannerTaskAssigneeCalisan")
  plannerTaskCommentsAuthored PlannerTaskComment[] @relation("PlannerTaskCommentAuthor")
  plannerTaskAttachmentsUploaded PlannerTaskAttachment[] @relation("PlannerTaskAttachmentUploader")
  plannerTaskHistoryActions PlannerTaskHistory[] @relation("PlannerTaskHistoryActor")

  @@index([createdAt(sort: Desc)])
  @@index([isim, soyisim])
  @@map("calisanlar")
}

/// Personel zorunlu eğitim takibi — Compliance Monitoring departmanı yönetir.
model TrainingRecord {
  id                     Int       @id @default(autoincrement())
  calisanId              Int       @map("calisan_id")
  trainingName           String    @map("training_name") @db.VarChar(300)
  completionDate         DateTime  @map("completion_date") @db.Date
  /// Boşsa süresiz/yenileme gerektirmeyen eğitim
  expiryDate             DateTime? @map("expiry_date") @db.Date
  certificateStoragePath String?   @map("certificate_storage_path") @db.VarChar(1000)
  certificateFileName    String?   @map("certificate_file_name") @db.VarChar(255)
  notes                  String?   @db.Text
  createdBy              Int?      @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  calisan Calisan  @relation("TrainingRecordCalisan", fields: [calisanId], references: [id], onDelete: Cascade)
  creator Calisan? @relation("TrainingRecordCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([calisanId])
  @@index([expiryDate])
  @@map("training_records")
}

/// User settings → ek departman seçenekleri (sabit liste + kayıtlı ekler)
model CustomDepartment {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("custom_departments")
}

/// Departman × izin anahtarı — yoksa `lib/department-permissions-legacy` varsayılanları geçerlidir.
model DepartmentPermission {
  id             String   @id @default(cuid())
  departmentKey  String   @map("department_key") @db.VarChar(120)
  permissionKey  String   @map("permission_key") @db.VarChar(80)
  allowed        Boolean
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([departmentKey, permissionKey])
  @@index([departmentKey])
  @@map("department_permissions")
}

/// Departman bazlı unvanlar (Compliance-Manager, Hangar-Technician vb.)
model DepartmentTitle {
  /// departmentName — Configurations → Departmanlar ile aynı metin olmalı.
  id             Int      @id @default(autoincrement())
  departmentName String   @map("department_name") @db.VarChar(100)
  titleName      String   @map("title_name") @db.VarChar(200)
  /// true ise bu unvan yönetici — izin taleplerini onaylayabilir.
  isManager      Boolean  @default(false) @map("is_manager")
  createdAt      DateTime @default(now()) @map("created_at")

  employees Calisan[]

  @@unique([departmentName, titleName])
  @@index([departmentName])
  @@index([isManager])
  @@map("department_titles")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestSubcategory {
  MAZERET_IZIN
  UCRETSIZ_IZIN
  YILLIK_UCRETLI_IZIN
  IDARI_IZIN
}

/// Personel izin talepleri — departman izolasyonu zorunlu.
model LeaveRequest {
  id           Int                @id @default(autoincrement())
  employeeId   Int                @map("employee_id")
  /// Otomatik atanan, aynı departmandaki ilk yönetici.
  approverId   Int?               @map("approver_id")
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  subcategory  LeaveRequestSubcategory?
  reason       String?            @db.Text
  status       LeaveRequestStatus @default(PENDING)
  /// Onaylama / red notu
  reviewNote   String?            @map("review_note") @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  employee Calisan  @relation("LeaveEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  approver Calisan? @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([approverId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

enum WorkerRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Self-service registration; admins approve into `Calisan`.
model WorkerRegistrationRequest {
  id              Int                      @id @default(autoincrement())
  status          WorkerRegistrationStatus @default(PENDING)
  isim            String?                  @db.VarChar(100)
  soyisim         String?                  @db.VarChar(100)
  departman       String?                  @db.VarChar(100)
  tcNo            String?                  @map("tc_no") @db.VarChar(20)
  dogumTarihi     DateTime?                @map("dogum_tarihi") @db.Date
  telNo           String?                  @map("tel_no") @db.VarChar(20)
  adres           String?                  @db.Text
  anneAdi         String?                  @map("anne_adi") @db.VarChar(100)
  babaAdi         String?                  @map("baba_adi") @db.VarChar(100)
  medeniDurum     String?                  @map("medeni_durum") @db.VarChar(50)
  cocuk           Int                      @default(0)
  kanGrubu        String?                  @map("kan_grubu") @db.VarChar(10)
  email           String                   @db.VarChar(255)
  egitimDurum     String?                  @map("egitim_durum") @db.VarChar(100)
  acilIletisim    String?                  @map("acil_iletisim") @db.VarChar(100)
  acilIletisimTel String?                  @map("acil_iletisim_tel") @db.VarChar(20)
  sgkSicilNo      String?                  @map("sgk_sicil_no") @db.VarChar(50)
  bankaAdi        String?                  @map("banka_adi") @db.VarChar(100)
  iban            String?                  @db.VarChar(34)
  iseGirisTarihi  DateTime?                @map("ise_giris_tarihi") @db.Date
  istenCikisTarihi DateTime?               @map("isten_cikis_tarihi") @db.Date
  password        String                   @db.VarChar(255)
  ekstra1         String?                  @map("ekstra_1") @db.VarChar(255)
  ekstra2         String?                  @map("ekstra_2") @db.VarChar(255)
  ekstra3         String?                  @map("ekstra_3") @db.VarChar(255)
  profilFotoStoragePath String?            @map("profil_foto_storage_path") @db.Text
  reviewedAt            DateTime?          @map("reviewed_at")
  reviewedByCalisanId   Int?               @map("reviewed_by_calisan_id")
  rejectionReason       String?            @map("rejection_reason") @db.Text
  approvedCalisanId     Int?               @map("approved_calisan_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  reviewedBy Calisan? @relation("WorkerRegistrationReviewedBy", fields: [reviewedByCalisanId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@map("worker_registration_requests")
}

// Çalışanlar arası mesajlaşma: 1:1 (lower/higher) veya grup (üyeler + groupTitle)
model DmConversation {
  id           Int      @id @default(autoincrement())
  isGroup      Boolean  @default(false) @map("is_group")
  groupTitle   String?  @map("group_title") @db.VarChar(200)
  lowerUserId  Int?     @map("lower_user_id")
  higherUserId Int?     @map("higher_user_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  messages   DmMessage[]
  readStates DmReadState[]
  members    DmConversationMember[]

  @@unique([lowerUserId, higherUserId])
  @@index([lowerUserId])
  @@index([higherUserId])
  @@index([updatedAt(sort: Desc)])
  @@index([isGroup])
  @@map("dm_conversations")
}

model DmConversationMember {
  id               Int      @id @default(autoincrement())
  conversationId   Int      @map("conversation_id")
  calisanId        Int      @map("calisan_id")
  joinedAt         DateTime @default(now()) @map("joined_at")

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  calisan      Calisan        @relation(fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([conversationId, calisanId])
  @@index([calisanId])
  @@map("dm_conversation_members")
}

model DmMessage {
  id                   Int      @id @default(autoincrement())
  conversationId       Int      @map("conversation_id")
  senderId             Int      @map("sender_id")
  body                 String   @default("") @db.Text
  attachmentPath       String?  @map("attachment_path") @db.VarChar(1000)
  attachmentFileName   String?  @map("attachment_file_name") @db.VarChar(255)
  attachmentMime       String?  @map("attachment_mime") @db.VarChar(200)
  attachmentSize       Int?     @map("attachment_size")
  attachmentPublicUrl  String?  @map("attachment_public_url") @db.VarChar(2000)
  createdAt            DateTime @default(now()) @map("created_at")

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Calisan        @relation("DmMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@map("dm_messages")
}

model DmReadState {
  id                Int      @id @default(autoincrement())
  conversationId    Int      @map("conversation_id")
  calisanId         Int      @map("calisan_id")
  lastReadMessageId Int?     @map("last_read_message_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  calisan      Calisan        @relation(fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([conversationId, calisanId])
  @@index([calisanId])
  @@map("dm_read_states")
}

// Hazard Reports Tablosu
model HazardReport {
  id              Int       @id @default(autoincrement())
  reportNo        String?   @unique @map("report_no") @db.VarChar(50)
  eventDate       DateTime  @map("event_date") @db.Date
  sourceType      String?   @map("source_type") @db.VarChar(100)
  isAnonymous     Boolean   @default(false) @map("is_anonymous")
  title           String?   @db.VarChar(500)
  details         String?   @db.Text
  reportedBy      Int?      @map("reported_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  reporter     Calisan?            @relation(fields: [reportedBy], references: [id], onDelete: Cascade)
  attachments  HazardAttachment[]

  @@index([createdAt(sort: Desc)])
  @@index([reportedBy])
  @@map("hazard_reports")
}

model HazardAttachment {
  id             Int      @id @default(autoincrement())
  hazardReportId Int      @map("hazard_report_id")
  storagePath    String   @map("storage_path") @db.VarChar(1000)
  fileName       String   @map("file_name") @db.VarChar(255)
  externalParticipants   String?   @map("external_participants") @db.Text
  mimeType       String   @map("mime_type") @db.VarChar(200)
  kind           String   @db.VarChar(20)
  publicUrl      String   @map("public_url") @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")

  hazardReport HazardReport @relation(fields: [hazardReportId], references: [id], onDelete: Cascade)

  @@index([hazardReportId])
  @@map("hazard_attachments")
}

// Incoming Correspondences Tablosu
model IncomingPaper {
  id              Int       @id @default(autoincrement())
  paperNo         String?   @unique @map("paper_no") @db.VarChar(50)
  from            String?   @db.VarChar(255)
  subject         String?   @db.VarChar(500)
  date            DateTime  @map("date") @db.Date
  content         String?   @db.Text
  pdfPath         String?   @map("pdf_path") @db.VarChar(500)
  pdfFileName     String?   @map("pdf_file_name") @db.VarChar(255)
  /// [{ "path": "BON-IP-001/file.pdf", "fileName": "file.pdf" }, ...]
  pdfAttachments  Json?     @map("pdf_attachments")
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator Calisan? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([createdBy])
  @@map("incoming_papers")
}

// Outgoing Correspondences Tablosu
model OutgoingCorrespondence {
  id              Int       @id @default(autoincrement())
  paperNo         String?   @unique @map("paper_no") @db.VarChar(50)
  /// outgoing-correspondence-departments.ts içindeki key (oc, sms, cmm, …)
  departmentKey   String?   @map("department_key") @db.VarChar(40)
  to              String?   @db.VarChar(255)
  subject         String?   @db.VarChar(500)
  date            DateTime  @map("date") @db.Date
  content         String?   @db.Text
  pdfPath         String?   @map("pdf_path") @db.VarChar(500)
  pdfFileName     String?   @map("pdf_file_name") @db.VarChar(255)
  /// [{ "path": "outgoing/BON-OC-001/file.pdf", "fileName": "file.pdf" }, ...]
  pdfAttachments  Json?     @map("pdf_attachments")
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator Calisan? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([createdBy])
  @@index([departmentKey])
  @@map("outgoing_correspondences")
}

/// Giden yazışma departman tipi + yazı no öneki (Configurations → Correspondences)
model OutgoingCorrespondenceDeptConfig {
  id                   Int      @id @default(autoincrement())
  key                  String   @unique @db.VarChar(40)
  label                String   @db.VarChar(200)
  paperPrefix          String   @unique @map("paper_prefix") @db.VarChar(50)
  /// true → BON-CMM-2026-001 (yıl İstanbul takvim yılı)
  includeYearInPaperNo Boolean  @default(false) @map("include_year_in_paper_no")
  sortOrder            Int      @default(0) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  releasedSlots OutgoingCorrespondenceReleasedSlot[]

  @@index([isActive, sortOrder])
  @@map("outgoing_correspondence_dept_configs")
}

/// Silinen yazı numaraları — yeni yazıda önce buradan en küçük sıra verilir
model OutgoingCorrespondenceReleasedSlot {
  id            Int      @id @default(autoincrement())
  departmentKey String   @map("department_key") @db.VarChar(40)
  /// Yıl yok formatında 0; BON-CMM-2026-001 için 2026
  calendarYear  Int      @default(0) @map("calendar_year")
  sequence      Int
  releasedAt    DateTime @default(now()) @map("released_at")

  config OutgoingCorrespondenceDeptConfig @relation(fields: [departmentKey], references: [key], onDelete: Cascade)

  @@unique([departmentKey, sequence, calendarYear])
  @@index([departmentKey, calendarYear, sequence])
  @@map("outgoing_correspondence_released_slots")
}

// Uçaklar Tablosu
model Ucaklar {
  id         Int                 @id @default(autoincrement())
  register   String              @db.VarChar(100)
  msn        String              @db.VarChar(100)
  isArchived Boolean             @default(false) @map("is_archived")
  documents  AircraftDocument[]

  @@index([isArchived])
  @@map("ucaklar")
}

model AircraftDocument {
  id          Int       @id @default(autoincrement())
  aircraftId  Int       @map("aircraft_id")
  category    String    @db.VarChar(50)
  docType     String    @map("doc_type") @db.VarChar(200)
  fileName    String    @map("file_name") @db.VarChar(255)
  storagePath String    @map("storage_path") @db.VarChar(1000)
  fileSize    Int?      @map("file_size")
  validFrom   DateTime? @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  isArchived  Boolean   @default(false) @map("is_archived")
  uploadedBy  Int?      @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  aircraft Ucaklar @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  uploader Calisan? @relation("AircraftDocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([aircraftId])
  @@map("aircraft_documents")
}

// Toplantı türleri (Supabase’te mevcut tablo: bigint id, text name, created_at)
model MeetingType {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.Text
  // Short code for numbers: TOPL-2026-001
  code      String   @default("TOPL") @db.VarChar(20) @map("code")
  createdAt DateTime @default(now()) @map("created_at")
  meetings  Meeting[]

  @@map("meeting_types")
}

// Toplantılar
model Meeting {
  id              Int       @id @default(autoincrement())
  meetingNo       String    @unique @map("meeting_no") @db.VarChar(50)
  title           String    @db.VarChar(500)
  plannedDate     DateTime  @map("planned_date") @db.Date
  initializedDate DateTime? @map("initialized_date")
  isOnline        Boolean   @default(false) @map("is_online")
  agenda          String?   @db.Text
  meetingTypeId   BigInt?   @map("meeting_type_id")
  status          String    @default("Planned") @db.VarChar(50)
  meetingMinutes  String?   @map("meeting_minutes") @db.Text
  actualDate      DateTime? @map("actual_date") @db.Date
  meetingTime     String?   @map("meeting_time") @db.VarChar(10)  // HH:MM
  location        String?   @db.VarChar(500)
  compiledBy      String?   @map("compiled_by") @db.VarChar(200)
  filePath        String?   @map("file_path") @db.VarChar(1000)
  fileName        String?   @map("file_name") @db.VarChar(255)
  externalParticipants String? @map("external_participants") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  meetingType  MeetingType?           @relation(fields: [meetingTypeId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  tasks        MeetingTask[]

  @@index([plannedDate])
  @@map("meetings")
}

model MeetingParticipant {
  id        Int @id @default(autoincrement())
  meetingId Int @map("meeting_id")
  calisanId Int @map("calisan_id")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  calisan Calisan @relation(fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([meetingId, calisanId])
  @@index([meetingId])
  @@index([calisanId])
  @@map("meeting_participants")
}

model MeetingTask {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(500)
  /// Pending Assessment | Pending Review | Revision Requested | Completed (+ legacy Open, In Progress)
  status     String    @default("Pending Assessment") @db.VarChar(50)
  dueDate    DateTime? @map("due_date") @db.Date
  /// Dolu ise görev bir toplantıya bağlıdır; toplantı silinince görev de silinir (ON DELETE CASCADE).
  meetingId  Int?      @map("meeting_id")
  assigneeId Int?      @map("assignee_id")
  /// Dolu ise görev bir kişiye değil doğrudan departmana atanmıştır (assigneeId ile birlikte kullanılmaz).
  assignedDepartment String? @map("assigned_department") @db.VarChar(100)
  assignedById Int?    @map("assigned_by_id")
  /// Son ret bildiriminde atayanın girdiği metin (yeniden gönderimde temizlenir)
  rejectionReason String? @map("rejection_reason") @db.Text
  filePath   String?   @map("file_path") @db.VarChar(1000)
  fileName   String?   @map("file_name") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  messages TaskMessage[]

  meeting  Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee Calisan? @relation("MeetingTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedBy Calisan? @relation("MeetingTaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@index([meetingId])
  @@index([assigneeId])
  @@index([assignedById])
  @@index([createdAt(sort: Desc)])
  @@map("meeting_tasks")
}


// Duyurular Tablosu
model Announcement {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(500)
  content     String    @db.Text
  /// false = pasif; dashboard’ta yalnızca aktif duyurular listelenir
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator Calisan? @relation(fields: [createdBy], references: [id])
  acknowledgments AnnouncementAcknowledgment[]

  @@index([createdAt(sort: Desc)])
  @@index([createdBy])
  @@index([isActive])
  @@map("announcements")
}

/// Çalışanın duyuruyu “okudum, anladım” ile onayladığı kayıt
model AnnouncementAcknowledgment {
  id             Int      @id @default(autoincrement())
  announcementId Int      @map("announcement_id")
  calisanId      Int      @map("calisan_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  calisan      Calisan      @relation(fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([announcementId, calisanId])
  @@index([calisanId])
  @@index([announcementId])
  @@map("announcement_acknowledgments")
}

/// AI sohbette referans için yüklenen şirket manueli (PDF’ten çıkarılmış metin)
model CompanyManual {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(300)
  slug        String   @unique @db.VarChar(160)
  contentText String   @map("content_text") @db.Text
  /// Supabase bucket-relative path (orijinal PDF/Office; önizleme ve revizyon akışı)
  fileStoragePath String? @map("file_storage_path") @db.Text
  fileName        String? @map("file_name") @db.VarChar(255)
  /// Manuelin ait olduğu kurum departmanı (Configurations → Departmanlar kayıtları veya özel etiket)
  department  String?  @db.VarChar(100) @map("department")
  /// Kurumsal manuel numarası (örn. OM-A, MNL-001)
  manualNumber String? @map("manual_no") @db.VarChar(120)
  /// Kullanıcının belirttiği revizyon tarihi (dosya yükleme tarihinden bağımsız)
  revisionDate DateTime? @map("revision_date") @db.Date
  /// Aynı mantıksal kitabın tüm revizyonları ortak seri kimliğini paylaşır
  seriesId    String   @default(dbgenerated("(gen_random_uuid())::text")) @map("series_id") @db.VarChar(36)
  revision    Int      @default(0)
  /// Seride kullanıcıya / AI seçicisinde gösterilen güncel kayıt (yalnızca biri true)
  isCurrent        Boolean  @default(true) @map("is_current")
  /// approved | pending | rejected
  status           String   @default("approved") @db.VarChar(20)
  rejectionReason  String?  @map("rejection_reason") @db.Text
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  creator Calisan? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  chunks  ManualChunk[]

  @@unique([seriesId, revision], map: "company_manuals_series_revision_uniq")
  @@index([title])
  @@index([seriesId])
  @@index([isCurrent])
  @@map("company_manuals")
}

/// pgvector embedding chunk'ları — her CompanyManual için 1000 karakterlik parçalar.
model ManualChunk {
  id         Int      @id @default(autoincrement())
  manualId   Int      @map("manual_id")
  chunkIndex Int      @map("chunk_index")
  chunkText  String   @map("chunk_text") @db.Text
  /// pgvector vector(768) — Prisma Unsupported, raw SQL ile yazılır/okunur.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now()) @map("created_at")

  manual CompanyManual @relation(fields: [manualId], references: [id], onDelete: Cascade)

  @@index([manualId])
  @@map("manual_chunks")
}

/// Kontrollü evrak — departman formları (revizyon serisi; Quality/Admin tümünü yönetir)
model DepartmentForm {
  id          Int      @id @default(autoincrement())
  /// Kurumsal form numarası (örn. FRM-001) — serideki revizyonlarda aynı kalabilir
  formNumber  String   @default("") @map("form_number") @db.VarChar(80)
  title       String   @db.VarChar(300)
  slug        String   @unique @db.VarChar(160)
  department  String   @db.VarChar(100) @map("department")
  contentText String   @map("content_text") @db.Text
  /// Supabase bucket-relative path (orijinal dosya — Aç ile yeni sekmede)
  fileStoragePath  String? @map("file_storage_path") @db.Text
  originalFileName String? @map("original_file_name") @db.VarChar(280)
  fileMimeType     String? @map("file_mime_type") @db.VarChar(120)
  seriesId    String   @default(dbgenerated("(gen_random_uuid())::text")) @map("series_id") @db.VarChar(36)
  revision    Int      @default(0)
  isCurrent   Boolean  @default(true) @map("is_current")
  /// approved | pending | rejected
  status          String   @default("approved") @db.VarChar(20)
  rejectionReason String?  @map("rejection_reason") @db.Text
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator Calisan? @relation("DepartmentFormCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([seriesId, revision], map: "department_forms_series_revision_uniq")
  @@index([department])
  @@index([isCurrent])
  @@map("department_forms")
}

/// Departman prosedürleri — revizyon serisi; erişim mantığı departman formları ile aynı (Admin tümü)
model DepartmentProcedure {
  id          Int      @id @default(autoincrement())
  /// Kurumsal prosedür numarası (örn. PR-001)
  procedureNumber String   @default("") @map("procedure_number") @db.VarChar(80)
  title       String   @db.VarChar(300)
  slug        String   @unique @db.VarChar(160)
  department  String   @db.VarChar(100)
  contentText String   @map("content_text") @db.Text
  fileStoragePath  String? @map("file_storage_path") @db.Text
  originalFileName String? @map("original_file_name") @db.VarChar(280)
  fileMimeType     String? @map("file_mime_type") @db.VarChar(120)
  seriesId    String   @default(dbgenerated("(gen_random_uuid())::text")) @map("series_id") @db.VarChar(36)
  revision    Int      @default(0)
  isCurrent   Boolean  @default(true) @map("is_current")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator Calisan? @relation("DepartmentProcedureCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([seriesId, revision], map: "department_procedures_series_revision_uniq")
  @@index([department])
  @@index([isCurrent])
  @@map("department_procedures")
}

/// Tek kurumsal Document Procedure — tüm sürümler aynı seriesId ile (sabit UUID uygulama kodunda)
model DocumentProcedureVersion {
  id          Int      @id @default(autoincrement())
  title       String   @default("Document Procedure") @db.VarChar(300)
  slug        String   @unique @db.VarChar(160)
  contentText String   @map("content_text") @db.Text
  /// Supabase bucket-relative path (incoming-papers vb.)
  fileStoragePath  String? @map("file_storage_path") @db.Text
  originalFileName String? @map("original_file_name") @db.VarChar(280)
  fileMimeType     String? @map("file_mime_type") @db.VarChar(120)
  seriesId    String   @map("series_id") @db.VarChar(36)
  revision    Int
  isCurrent   Boolean  @default(true) @map("is_current")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator Calisan? @relation("DocumentProcedureCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([seriesId, revision], map: "document_procedure_series_revision_uniq")
  @@index([isCurrent])
  @@map("document_procedure_versions")
}

model TaskMessage {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  senderId  Int?     @map("sender_id")
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task   MeetingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender Calisan?    @relation(fields: [senderId], references: [id])

  @@index([taskId])
  @@map("task_messages")
}
model TaskAttachment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  fileName  String   @db.VarChar(255) @map("file_name")
  filePath  String   @db.VarChar(500) @map("file_path")
  fileSize  Int?     @map("file_size")
  fileType  String?  @db.VarChar(100) @map("file_type")
  uploadedBy Int?    @map("uploaded_by")
  createdAt DateTime @default(now()) @map("created_at")

  task     MeetingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader Calisan?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_attachments")
}

/// Task board / bow-tie: kurum genelinde risk başına tek paylaşımlı kayıt.
model SafetyRiskBoard {
  id                  String   @id @default(cuid())
  /// Başlıktan türetilen sabit anahtar (max 600 karakter)
  riskKey             String   @unique @map("risk_key") @db.VarChar(600)
  /// Tam risk / olay başlığı (görüntü)
  riskTitle           String   @map("risk_title") @db.Text
  probability         Int?
  severity            String?  @db.VarChar(1)
  /// İlk “Save initial assessment” ile kilitlenen değerler
  initialProbability  Int?     @map("initial_probability")
  initialSeverity     String?  @map("initial_severity") @db.VarChar(1)
  /// Koşullar sağlandığında “Save final assessment” ile kaydedilen değerler
  finalProbability    Int?     @map("final_probability")
  finalSeverity       String?  @map("final_severity") @db.VarChar(1)
  threats             Json
  consequences        Json
  threatOpenById      Json     @map("threat_open_by_id")
  consequenceOpenById Json     @map("consequence_open_by_id")
  /// Bow-tie etkinlik geçmişi (task board history paneli)
  boardHistory        Json     @default("[]") @map("board_history")
  updatedByCalisanId  Int?     @map("updated_by_calisan_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  updatedBy Calisan? @relation("SafetyRiskBoardUpdatedBy", fields: [updatedByCalisanId], references: [id], onDelete: SetNull)

  @@index([updatedAt(sort: Desc)])
  @@map("safety_risk_boards")
}

/// Risk Board liste satırları (tek satır, id=1): seed yerine kalıcı katalog.
model SafetyRiskBoardCatalog {
  id        Int      @id @default(1)
  entries   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("safety_risk_board_catalog")
}

/// Configurations → Safety settings: kurumsal hedefler (sıra + ekleme tarihi otomatik).
model SafetyObjective {
  id             Int      @id @default(autoincrement())
  sortOrder      Int      @map("sort_order")
  text           String   @db.Text
  insertionDate  DateTime @map("insertion_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("safety_objectives")
}

/// Özel rapor türleri (sıra otomatik).
model CustomReportType {
  id        Int      @id @default(autoincrement())
  sortOrder Int      @map("sort_order")
  name      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("custom_report_types")
}

/// Denetim kategorisi (Configurations → Audit Settings’ten yönetilir)
model AuditCategoryType {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(400)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subcategories AuditSubCategoryType[]
  entries       AuditPlanEntry[]

  @@index([sortOrder])
  @@index([isActive])
  @@map("audit_category_types")
}

/// Üst kategoriye bağlı alt kategori (Audit Plan formu)
model AuditSubCategoryType {
  id                  Int      @id @default(autoincrement())
  auditCategoryTypeId Int      @map("audit_category_type_id")
  name                String   @db.VarChar(400)
  sortOrder           Int      @default(0) @map("sort_order")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  auditCategoryType AuditCategoryType @relation(fields: [auditCategoryTypeId], references: [id], onDelete: Cascade)
  entries           AuditPlanEntry[]

  @@index([auditCategoryTypeId])
  @@index([sortOrder])
  @@map("audit_subcategory_types")
}

/// Denetim planı satırı (Compliance → Audit Plan)
model AuditPlanEntry {
  id                  Int       @id @default(autoincrement())
  plannedDate         DateTime  @map("planned_date") @db.Date
  datePostponed       DateTime? @map("date_postponed") @db.Date
  initializedDate     DateTime? @map("initialized_date") @db.Date
  auditCategoryTypeId    Int  @map("audit_category_type_id")
  auditSubCategoryTypeId Int? @map("audit_subcategory_type_id")
  auditNumberPrefix      String? @map("audit_number_prefix") @db.VarChar(100)
  ct                  String    @default("") @db.VarChar(20)
  remarks             String?   @db.Text
  status              String    @default("Initialized") @db.VarChar(50)
  /// Cancelled durumuna geçildiğinde girilen zorunlu iptal nedeni — Detay/Audit Screen'de gösterilir, geçmişte kalıcı olarak saklanır
  cancellationReason  String?   @db.Text @map("cancellation_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  auditCategoryType    AuditCategoryType     @relation(fields: [auditCategoryTypeId], references: [id], onDelete: Restrict)
  auditSubCategoryType AuditSubCategoryType? @relation(fields: [auditSubCategoryTypeId], references: [id], onDelete: SetNull)
  auditors             AuditPlanAuditor[]
  auditees             AuditPlanAuditee[]
  auditeeDepartments   AuditPlanAuditeeDepartment[]
  checklistAssignments AuditPlanChecklistAssignment[]
  sessions             AuditSession[]
  documents            AuditPlanDocument[]
  /// Checklist/session'dan bağımsız, doğrudan bu denetime manuel olarak eklenen bulgular
  manualFindings       AuditFinding[] @relation("AuditPlanEntryManualFindings")
  /// Reopen ve durum değişikliği olayları (Geçmiş / Audit History paneli)
  history              AuditPlanEntryHistory[]
  /// Public Audit Response Link — denetlenen tarafın not/dosya gönderebildiği güvenli link(ler)
  responseLinks        AuditResponseLink[]
  /// Public link (veya kendi hesabı) üzerinden denetlenen tarafın gönderdiği notlar
  responseNotes        AuditResponseNote[]

  @@index([plannedDate])
  @@index([auditCategoryTypeId])
  @@index([auditSubCategoryTypeId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_plan_entries")
}

/// Denetim kaydına doğrudan bağlı genel dosyalar (rapor, imzalı checklist, kapanış
/// dokümanları vb.) — checklist madde eklerinden bağımsız, Audit ID ile ilişkili.
model AuditPlanDocument {
  id               Int      @id @default(autoincrement())
  auditPlanEntryId Int      @map("audit_plan_entry_id")
  fileName         String   @map("file_name") @db.VarChar(255)
  storagePath      String   @map("storage_path") @db.VarChar(1000)
  mimeType         String?  @map("mime_type") @db.VarChar(200)
  fileSizeBytes    Int?     @map("file_size_bytes")
  uploadedBy       Int?     @map("uploaded_by")
  /// "auditor" | "auditee" — kim yükledi (Manage Audit'te "Uploaded by Auditor" /
  /// "Submitted by Auditee" ayrımı için). NULL = eski kayıt, uygulama katmanında
  /// "auditor" olarak ele alınır (geriye dönük uyumluluk, hiçbir backfill gerekmez).
  source           String?  @db.VarChar(10)
  /// Public Audit Response Link üzerinden yüklendiyse hangi link — link revoke/silinse
  /// bile bu dosya kaydı SetNull ile kalıcı olarak audit'e bağlı kalır, silinmez.
  responseLinkId   Int?     @map("response_link_id")
  /// Bonjour hesabı olmayan external submitter'ın isim/e-posta bilgisi (varsa)
  submitterName    String?  @map("submitter_name") @db.VarChar(200)
  submitterEmail   String?  @map("submitter_email") @db.VarChar(200)
  createdAt        DateTime @default(now()) @map("created_at")

  entry        AuditPlanEntry     @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  uploader     Calisan?           @relation("AuditPlanDocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  responseLink AuditResponseLink? @relation(fields: [responseLinkId], references: [id], onDelete: SetNull)

  @@index([auditPlanEntryId])
  @@index([responseLinkId])
  @@map("audit_plan_documents")
}

/// Public Audit Response Link — denetlenen tarafa (Bonjour hesabı gerektirmeden) gönderilen,
/// tahmin edilemeyen token içeren güvenli bağlantı. Yalnızca ilgili tek denetime erişim sağlar;
/// bu bağlantı üzerinden yalnızca not girilebilir ve dosya yüklenebilir (checklist/finding/status
/// değişikliği YAPILAMAZ — bu kısıtlama her public API route'unda sunucu tarafında uygulanır).
model AuditResponseLink {
  id               Int       @id @default(autoincrement())
  auditPlanEntryId Int       @map("audit_plan_entry_id")
  /// Uzun, tahmin edilemeyen rastgele token — URL'de kullanılır, tek başına erişim yeter.
  token            String    @unique @db.VarChar(64)
  /// Boşsa süresiz; doluysa bu tarihten sonra link otomatik geçersiz sayılır.
  expiresAt        DateTime? @map("expires_at")
  /// Doluysa link devre dışı — yetkili kullanıcı tarafından manuel iptal edilmiş veya
  /// denetim Completed/Cancelled olduğunda otomatik iptal edilmiştir. Reopen bu alanı
  /// OTOMATİK sıfırlamaz — yeniden aktif etmek yetkili kullanıcının açık işlemini gerektirir.
  revokedAt        DateTime? @map("revoked_at")
  createdBy        Int?      @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  entry     AuditPlanEntry       @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  creator   Calisan?             @relation("AuditResponseLinkCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  notes     AuditResponseNote[]
  documents AuditPlanDocument[]
  checklistSubmissions AuditeeChecklistSubmission[]

  @@index([auditPlanEntryId])
  @@map("audit_response_links")
}

/// Public Audit Response Link (veya giriş yapmış bir denetlenenin kendi hesabı) üzerinden
/// gönderilen not/açıklama — kalıcıdır, yalnızca yetkili bir Bonjour kullanıcısı silebilir;
/// public link üzerinden gönderildikten sonra düzenlenemez/silinemez.
model AuditResponseNote {
  id                    Int      @id @default(autoincrement())
  auditPlanEntryId      Int      @map("audit_plan_entry_id")
  /// Hangi response link kullanıldı — link daha sonra iptal edilse/silinse bile bu not
  /// SetNull ile kalıcı olarak audit'e bağlı kalır.
  responseLinkId        Int?     @map("response_link_id")
  note                  String   @db.Text
  /// Bonjour hesabı olan bir denetlenen kendi oturumuyla gönderdiyse dolu.
  submittedByCalisanId  Int?     @map("submitted_by_calisan_id")
  /// Bonjour hesabı olmayan external kullanıcının isim/e-posta bilgisi (varsa)
  submitterName         String?  @map("submitter_name") @db.VarChar(200)
  submitterEmail        String?  @map("submitter_email") @db.VarChar(200)
  submittedAt           DateTime @default(now()) @map("submitted_at")

  entry        AuditPlanEntry     @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  responseLink AuditResponseLink? @relation(fields: [responseLinkId], references: [id], onDelete: SetNull)
  submittedBy  Calisan?           @relation("AuditResponseNoteSubmitter", fields: [submittedByCalisanId], references: [id], onDelete: SetNull)

  @@index([auditPlanEntryId])
  @@index([responseLinkId])
  @@map("audit_response_notes")
}

/// Denetim kaydı olay geçmişi (Reopen, durum değişiklikleri vb.) — "Geçmiş / Audit History"
/// panelinde kim/ne zaman yaptı bilgisiyle gösterilir; append-only, hiçbir kayıt silinmez.
model AuditPlanEntryHistory {
  id               Int      @id @default(autoincrement())
  auditPlanEntryId Int      @map("audit_plan_entry_id")
  createdAt        DateTime @default(now()) @map("created_at")
  actorId          Int?     @map("actor_id")
  /// REOPENED | STATUS_CHANGED
  eventType        String   @db.VarChar(40) @map("event_type")
  statusFrom       String?  @db.VarChar(50) @map("status_from")
  statusTo         String?  @db.VarChar(50) @map("status_to")
  note             String?  @db.Text

  entry AuditPlanEntry @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  actor Calisan?       @relation("AuditPlanEntryHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([auditPlanEntryId, createdAt])
  @@map("audit_plan_entry_history")
}

/// Denetim checklist şablonu (Compliance → Checklists)
model AuditChecklist {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(400)
  /// Örn. BON-CMM-CL-010 — boşsa API `BON-CMM-CL-{id}` üretir
  checklistNumber String? @unique @db.VarChar(100) @map("checklist_number")
  checklistType   String  @default("Classic (Satisfactory/Unsatisfactory)") @map("checklist_type") @db.VarChar(200)
  initialRevisionNumber Int      @default(0) @map("initial_revision_number")
  initialRevisionDate   DateTime? @map("initial_revision_date") @db.Date
  latestRevisionNumber  Int      @default(0) @map("latest_revision_number")
  latestRevisionDate    DateTime? @map("latest_revision_date") @db.Date
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items        AuditChecklistItem[]
  revisions    AuditChecklistRevision[]
  assignments  AuditPlanChecklistAssignment[]
  sessions     AuditSession[]

  @@index([sortOrder])
  @@index([isActive])
  @@map("audit_checklists")
}

/// Checklist’in belirli bir revizyonundaki anlık kopya (başlık, açıklama, maddeler)
model AuditChecklistRevision {
  id               Int      @id @default(autoincrement())
  auditChecklistId Int      @map("audit_checklist_id")
  revisionNumber   Int      @map("revision_number")
  revisionDate     DateTime @map("revision_date") @db.Date
  title            String   @db.VarChar(400)
  description      String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  checklist AuditChecklist @relation(fields: [auditChecklistId], references: [id], onDelete: Cascade)
  items     AuditChecklistRevisionItem[]

  @@unique([auditChecklistId, revisionNumber])
  @@index([auditChecklistId])
  @@map("audit_checklist_revisions")
}

model AuditChecklistRevisionItem {
  id         Int      @id @default(autoincrement())
  revisionId Int      @map("audit_checklist_revision_id")
  label      String   @db.Text
  /// Regülasyon / doküman referansı (örn. SHT-17.3 Md.5)
  reference  String?  @db.VarChar(500) @map("reference")
  /// Bölüm başlığı; ardışık aynı değer tek başlık satırında gösterilir
  section    String?  @db.VarChar(400) @map("section")
  sortOrder  Int      @default(0) @map("sort_order")
  isRequired Boolean  @default(true) @map("is_required")
  /// Konu başlığı satırı ise true — bu satırda S/U/N/A işaretlenmez
  isHeading  Boolean  @default(false) @map("is_heading")
  createdAt  DateTime @default(now()) @map("created_at")

  revision AuditChecklistRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@index([sortOrder])
  @@map("audit_checklist_revision_items")
}

model AuditChecklistItem {
  id               Int      @id @default(autoincrement())
  auditChecklistId Int      @map("audit_checklist_id")
  label            String   @db.Text
  reference        String?  @db.VarChar(500) @map("reference")
  section          String?  @db.VarChar(400) @map("section")
  sortOrder        Int      @default(0) @map("sort_order")
  isRequired       Boolean  @default(true) @map("is_required")
  /// Konu başlığı satırı ise true — bu satırda S/U/N/A işaretlenmez
  isHeading        Boolean  @default(false) @map("is_heading")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  checklist    AuditChecklist @relation(fields: [auditChecklistId], references: [id], onDelete: Cascade)
  sessionItems AuditSessionItem[]

  @@index([auditChecklistId])
  @@index([sortOrder])
  @@map("audit_checklist_items")
}

/// Audit Plan'a bağlı gerçek denetim oturumu
model AuditSession {
  id               Int       @id @default(autoincrement())
  auditPlanEntryId Int       @map("audit_plan_entry_id")
  auditChecklistId Int       @map("audit_checklist_id")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  status           String    @default("InProgress") @db.VarChar(50) // InProgress | Completed
  /// Denetçi genel yorumu (oturum bazında)
  auditorComment   String?   @db.Text @map("auditor_comment")
  /// Denetlenen genel yorumu / itirazı (oturum bazında)
  auditeeComment   String?   @db.Text @map("auditee_comment")
  /// Doluysa bu session artık AKTİF DEĞİL — checklist denetimden kaldırıldığında (Remove)
  /// işaretlenir. Fiziksel olarak SİLİNMEZ (audit trail: eski cevaplar, oluşan Finding'ler
  /// kalıcı kalır); yalnızca "yeni checklist ataması" ve "aktif oturum" aramalarında hariç
  /// tutulur. Aynı checklist tekrar atandığında bu satır yerine YENİ, boş bir AuditSession
  /// oluşturulur — böylece eski cevaplar geri gelmez.
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  entry     AuditPlanEntry @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  checklist AuditChecklist @relation(fields: [auditChecklistId], references: [id], onDelete: Restrict)
  items     AuditSessionItem[]
  findings  AuditFinding[]

  @@index([auditPlanEntryId])
  @@index([auditChecklistId])
  @@index([archivedAt])
  @@map("audit_sessions")
}

/// Her checklist maddesinin denetim sonucu
model AuditSessionItem {
  id                   Int      @id @default(autoincrement())
  auditSessionId       Int      @map("audit_session_id")
  auditChecklistItemId Int      @map("audit_checklist_item_id")
  /// S = Satisfactory, U = Unsatisfactory, NA = N/A, OBS = Observation, null = yanıtlanmadı
  result               String?  @db.VarChar(3) @map("result")
  /// Denetçi notu
  notes                String?  @db.Text
  /// Denetlenenin cevabı / yorumu
  auditeeNotes         String?  @db.Text @map("auditee_notes")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  session       AuditSession      @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  checklistItem AuditChecklistItem @relation(fields: [auditChecklistItemId], references: [id], onDelete: Restrict)
  finding       AuditFinding?
  attachments   AuditSessionItemAttachment[]
  /// Public Audit Response Link üzerinden denetlenenin bu soruya gönderdiği cevap/not/dosya
  /// gönderimleri — append-only, resmi result/notes alanlarını asla otomatik değiştirmez.
  auditeeSubmissions AuditeeChecklistSubmission[]

  @@unique([auditSessionId, auditChecklistItemId])
  @@index([auditSessionId])
  @@map("audit_session_items")
}

/// Denetim sırasında eklenen dosya ekleri (soru bazında)
model AuditSessionItemAttachment {
  id                 Int      @id @default(autoincrement())
  auditSessionItemId Int      @map("audit_session_item_id")
  uploadedBy         String   @default("auditor") @db.VarChar(20) @map("uploaded_by") // "auditor" | "auditee"
  fileName           String   @db.VarChar(500) @map("file_name")
  storagePath        String   @db.Text @map("storage_path")
  mimeType           String?  @db.VarChar(200) @map("mime_type")
  fileSizeBytes      Int?     @map("file_size_bytes")
  uploadedAt         DateTime @default(now()) @map("uploaded_at")

  sessionItem AuditSessionItem @relation(fields: [auditSessionItemId], references: [id], onDelete: Cascade)

  @@index([auditSessionItemId])
  @@map("audit_session_item_attachments")
}

/// Denetimde tespit edilen bulgu (Unsatisfactory item → Finding)
model AuditFinding {
  id                 Int       @id @default(autoincrement())
  /// BON-AF-XXX formatında otomatik kod
  findingCode        String    @unique @db.VarChar(50) @map("finding_code")
  /// Checklist üzerinden (Unsatisfactory sonucuyla) otomatik oluşan bulgularda dolu.
  /// Denetim Planı panelinden manuel eklenen bulgularda null olabilir (bkz. auditPlanEntryId).
  auditSessionId     Int?      @map("audit_session_id")
  auditSessionItemId Int?      @unique @map("audit_session_item_id")
  /// Denetim Planı "Bulgu Ekle" ile checklist/session'dan bağımsız oluşturulan bulgularda dolu.
  auditPlanEntryId   Int?      @map("audit_plan_entry_id")
  /// Level1 | Level2 | Observation — YALNIZCA SACA/SAFA DIŞINDAKİ audit type'larında dolu
  /// (ör. Internal Audit). SACA/SAFA denetimlerinde bu alan artık kullanılmaz, her zaman
  /// null kaydedilir — o denetim tipinde tek sınıflandırma findingCategory'dir (bkz. altı).
  /// Eski SACA/SAFA kayıtlarında (bu ayrım öncesi oluşturulmuş) geriye dönük uyumluluk için
  /// tarihsel Level değeri silinmeden bırakılmıştır, ama artık okunmaz/kullanılmaz.
  findingLevel       String?   @db.VarChar(20) @map("finding_level")
  /// CAT1 | CAT2 | CAT3 — SACA/SAFA denetimlerinde ZORUNLU ve TEK sınıflandırma; diğer audit
  /// type'larında (ör. Internal) her zaman null — orada tek sınıflandırma findingLevel'dır.
  findingCategory    String?   @db.VarChar(10) @map("finding_category")
  /// Bulgunun açıklaması / gözlem
  explanation        String    @db.Text
  /// Referans madde / doküman
  reference          String?   @db.VarChar(500)
  field              String?   @db.VarChar(400) // audit alanı (kategori/alt)
  auditNumber        String?   @db.VarChar(100) @map("audit_number")
  initializedOn      DateTime  @default(now()) @map("initialized_on")
  dueDate            DateTime? @map("due_date") @db.Date
  status             String    @default("Open") @db.VarChar(50) // Open | Closed
  assignedToId       Int?      @map("assigned_to_id")
  /// Doluysa bulgu silinmiş sayılır (soft delete) — hard delete YAPILMAZ, kendi
  /// AuditFindingHistory kaydı kaybolmasın diye. Tüm liste/okuma sorguları bu alanı
  /// null olarak filtreler; findingCode benzersizliği bu satırlarda da korunur.
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  session     AuditSession?      @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  sessionItem AuditSessionItem?  @relation(fields: [auditSessionItemId], references: [id], onDelete: SetNull)
  manualEntry AuditPlanEntry?    @relation("AuditPlanEntryManualFindings", fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  assignedTo  Calisan?           @relation("AuditFindingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  responses   AuditFindingResponse[]
  extensions  AuditFindingExtension[]
  /// Checklist ekleri (AuditSessionItemAttachment) veya Audit Files'tan (AuditPlanDocument)
  /// bağımsız — doğrudan bu bulguya yüklenen dosyalar.
  files       AuditFindingFile[]
  /// Reminder gönderimi, durum değişikliği vb. kronolojik olay geçmişi.
  history     AuditFindingHistory[]

  @@index([auditSessionId])
  @@index([auditPlanEntryId])
  @@index([status])
  @@index([dueDate])
  @@map("audit_findings")
}

/// Bulguya doğrudan yüklenen dosyalar — checklist madde eklerinden ve Audit Files'tan
/// bağımsız, doğrudan Finding ID ile ilişkilidir.
model AuditFindingFile {
  id             Int      @id @default(autoincrement())
  auditFindingId Int      @map("audit_finding_id")
  fileName       String   @map("file_name") @db.VarChar(500)
  storagePath    String   @map("storage_path") @db.Text
  mimeType       String?  @map("mime_type") @db.VarChar(200)
  fileSizeBytes  Int?     @map("file_size_bytes")
  uploadedBy     Int?     @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  finding  AuditFinding @relation(fields: [auditFindingId], references: [id], onDelete: Cascade)
  uploader Calisan?     @relation("AuditFindingFileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([auditFindingId])
  @@map("audit_finding_files")
}

/// Bulguya özel kronolojik olay geçmişi (Reminder gönderimi vb.) — kim/ne zaman bilgisiyle.
model AuditFindingHistory {
  id             Int      @id @default(autoincrement())
  auditFindingId Int      @map("audit_finding_id")
  createdAt      DateTime @default(now()) @map("created_at")
  actorId        Int?     @map("actor_id")
  /// REMINDER_SENT | STATUS_CHANGED | ASSIGNED | ...
  eventType      String   @db.VarChar(40) @map("event_type")
  note           String?  @db.Text

  finding AuditFinding @relation(fields: [auditFindingId], references: [id], onDelete: Cascade)
  actor   Calisan?     @relation("AuditFindingHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([auditFindingId, createdAt])
  @@map("audit_finding_history")
}

/// Bulgulara verilen kök neden analizi cevabı
model AuditFindingResponse {
  id             Int      @id @default(autoincrement())
  auditFindingId Int      @map("audit_finding_id")
  respondedById  Int?     @map("responded_by_id")
  /// Kök neden analizi metni
  rootCause      String?  @db.Text @map("root_cause")
  /// Düzeltici faaliyet
  correctiveAction String? @db.Text @map("corrective_action")
  /// Önleyici faaliyet
  preventiveAction String? @db.Text @map("preventive_action")
  /// CPA (Corrective & Preventive Action) durumu: Pending | Accepted | Rejected
  cpaStatus      String   @default("Pending") @db.VarChar(50) @map("cpa_status")
  /// Denetçinin red gerekçesi
  rejectComment  String?  @db.Text @map("reject_comment")
  submittedAt    DateTime @default(now()) @map("submitted_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  finding      AuditFinding @relation(fields: [auditFindingId], references: [id], onDelete: Cascade)
  respondedBy  Calisan?     @relation("AuditFindingResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  attachments  AuditFindingAttachment[]

  @@index([auditFindingId])
  @@map("audit_finding_responses")
}

/// Cevaba veya bulgulara eklenen dosya ekleri
model AuditFindingAttachment {
  id                     Int      @id @default(autoincrement())
  auditFindingResponseId Int      @map("audit_finding_response_id")
  fileName               String   @db.VarChar(500) @map("file_name")
  storagePath            String   @db.Text @map("storage_path")
  mimeType               String?  @db.VarChar(200) @map("mime_type")
  fileSizeBytes          Int?     @map("file_size_bytes")
  uploadedAt             DateTime @default(now()) @map("uploaded_at")

  response AuditFindingResponse @relation(fields: [auditFindingResponseId], references: [id], onDelete: Cascade)

  @@index([auditFindingResponseId])
  @@map("audit_finding_attachments")
}

/// Bulgulara talep edilen ek süre (Extension)
model AuditFindingExtension {
  id             Int      @id @default(autoincrement())
  auditFindingId Int      @map("audit_finding_id")
  requestedById  Int?     @map("requested_by_id")
  newDueDate     DateTime @map("new_due_date") @db.Date
  reason         String?  @db.Text
  status         String   @default("Pending") @db.VarChar(50) // Pending | Approved | Rejected
  isExpired      Boolean  @default(false) @map("is_expired")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  finding     AuditFinding @relation(fields: [auditFindingId], references: [id], onDelete: Cascade)
  requestedBy Calisan?     @relation("AuditFindingExtensionRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([auditFindingId])
  @@map("audit_finding_extensions")
}

/// Public Audit Response Link üzerinden denetlenenin bir checklist maddesine gönderdiği
/// cevap — resmi AuditSessionItem.result/notes alanlarının ÜZERİNE YAZILMAZ, ayrı tutulur.
/// Reddedilirse denetlenen yeni bir submission gönderebilir (append-only geçmiş; her
/// gönderim kendi review durumunu taşır — Manage Audit'te tüm geçmiş görülebilir).
model AuditeeChecklistSubmission {
  id                   Int       @id @default(autoincrement())
  auditSessionItemId   Int       @map("audit_session_item_id")
  /// Hangi response link üzerinden gönderildi — link iptal/silinse bile SetNull ile kalır.
  responseLinkId       Int?      @map("response_link_id")
  /// Denetlenenin soruya verdiği cevap (serbest metin — checklist türünden bağımsız,
  /// auditörün S/U/NA/OBS sınıflandırmasından ayrı).
  auditeeResponse      String?   @db.Text @map("auditee_response")
  auditeeNote          String?   @db.Text @map("auditee_note")
  /// Bonjour hesabı olan bir denetlenen kendi oturumuyla gönderdiyse dolu.
  submittedByCalisanId Int?      @map("submitted_by_calisan_id")
  submitterName        String?   @db.VarChar(200) @map("submitter_name")
  submitterEmail       String?   @db.VarChar(200) @map("submitter_email")
  /// Pending | Accepted | Rejected
  reviewStatus         String    @default("Pending") @db.VarChar(20) @map("review_status")
  reviewedById         Int?      @map("reviewed_by_id")
  reviewedAt           DateTime? @map("reviewed_at")
  /// Reddetme gerekçesi — public linkte denetlenene gösterilir.
  reviewNote           String?   @db.Text @map("review_note")
  submittedAt          DateTime  @default(now()) @map("submitted_at")

  sessionItem  AuditSessionItem   @relation(fields: [auditSessionItemId], references: [id], onDelete: Cascade)
  responseLink AuditResponseLink? @relation(fields: [responseLinkId], references: [id], onDelete: SetNull)
  submittedBy  Calisan?           @relation("AuditeeChecklistSubmissionSubmitter", fields: [submittedByCalisanId], references: [id], onDelete: SetNull)
  reviewedBy   Calisan?           @relation("AuditeeChecklistSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  files        AuditeeChecklistSubmissionFile[]

  @@index([auditSessionItemId])
  @@index([responseLinkId])
  @@index([reviewStatus])
  @@map("audit_checklist_auditee_submissions")
}

/// Bir auditee checklist submission'ına eklenen dosyalar — Audit ID + Checklist Item ID +
/// Submission ID ile ilişkilidir, genel Audit Files (AuditPlanDocument) ile karışmaz.
model AuditeeChecklistSubmissionFile {
  id            Int      @id @default(autoincrement())
  submissionId  Int      @map("submission_id")
  fileName      String   @db.VarChar(500) @map("file_name")
  storagePath   String   @db.Text @map("storage_path")
  mimeType      String?  @db.VarChar(200) @map("mime_type")
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  submission AuditeeChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("audit_checklist_auditee_submission_files")
}

/// Denetim satırına atanmış checklist şablonu
model AuditPlanChecklistAssignment {
  id               Int      @id @default(autoincrement())
  auditPlanEntryId Int      @map("audit_plan_entry_id")
  auditChecklistId Int      @map("audit_checklist_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  entry     AuditPlanEntry @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  checklist AuditChecklist @relation(fields: [auditChecklistId], references: [id], onDelete: Cascade)

  @@unique([auditPlanEntryId, auditChecklistId])
  @@index([auditChecklistId])
  @@map("audit_plan_checklist_assignments")
}

model AuditPlanAuditor {
  id               Int @id @default(autoincrement())
  auditPlanEntryId Int @map("audit_plan_entry_id")
  calisanId        Int @map("calisan_id")

  entry   AuditPlanEntry @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  calisan Calisan        @relation("AuditPlanAuditorCalisan", fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([auditPlanEntryId, calisanId])
  @@index([calisanId])
  @@map("audit_plan_auditors")
}

model AuditPlanAuditee {
  id               Int @id @default(autoincrement())
  auditPlanEntryId Int @map("audit_plan_entry_id")
  calisanId        Int @map("calisan_id")

  entry   AuditPlanEntry @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)
  calisan Calisan        @relation("AuditPlanAuditeeCalisan", fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([auditPlanEntryId, calisanId])
  @@index([calisanId])
  @@map("audit_plan_auditees")
}

/// Denetlenen olarak tek tek kişi yerine (veya kişilerle birlikte) bir departman/grup
/// atanabilir — o departmandaki herhangi bir yetkili kullanıcı denetimi görebilir/cevaplayabilir.
/// departmentName, Configurations → Departmanlar (CustomDepartment) ile aynı metindir.
model AuditPlanAuditeeDepartment {
  id               Int    @id @default(autoincrement())
  auditPlanEntryId Int    @map("audit_plan_entry_id")
  departmentName   String @map("department_name") @db.VarChar(100)

  entry AuditPlanEntry @relation(fields: [auditPlanEntryId], references: [id], onDelete: Cascade)

  @@unique([auditPlanEntryId, departmentName])
  @@index([departmentName])
  @@map("audit_plan_auditee_departments")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Çalışanların sistem sorunlarını Admin’e iletmesi; Admin aksiyon notu ve durum günceller.
model SupportTicket {
  id                 Int                 @id @default(autoincrement())
  subject            String?             @db.VarChar(200)
  content            String              @db.Text
  status             SupportTicketStatus @default(OPEN)
  adminAction        String?             @map("admin_action") @db.Text
  departmentSnapshot String?             @map("department_snapshot") @db.VarChar(100)
  createdBy          Int                 @map("created_by")
  lastUpdatedBy      Int?                @map("last_updated_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  creator     Calisan  @relation("SupportTicketCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  lastUpdater Calisan? @relation("SupportTicketAdmin", fields: [lastUpdatedBy], references: [id], onDelete: SetNull)
  attachments SupportTicketAttachment[]
  history     SupportTicketHistory[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([createdBy])
  @@map("support_tickets")
}

model SupportTicketAttachment {
  id              Int      @id @default(autoincrement())
  supportTicketId Int      @map("support_ticket_id")
  storagePath     String   @map("storage_path") @db.VarChar(1000)
  fileName        String   @map("file_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(200)
  sizeBytes       Int      @map("size_bytes")
  createdAt       DateTime @default(now()) @map("created_at")

  supportTicket SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)

  @@index([supportTicketId])
  @@map("support_ticket_attachments")
}

/// Destek talebi oluşturma ve admin güncellemeleri — tam geçmiş (audit).
model SupportTicketHistory {
  id              Int                  @id @default(autoincrement())
  supportTicketId Int                  @map("support_ticket_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  actorId         Int                  @map("actor_id")
  /// CREATED | ADMIN_UPDATE
  eventType       String               @map("event_type") @db.VarChar(40)
  statusFrom      SupportTicketStatus? @map("status_from")
  statusTo        SupportTicketStatus? @map("status_to")
  adminNote       String?              @map("admin_note") @db.Text
  subjectSnapshot String?              @map("subject_snapshot") @db.VarChar(200)
  contentSnapshot String?              @map("content_snapshot") @db.Text
  attachmentMeta  Json?                @map("attachment_meta")

  ticket SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  actor  Calisan       @relation("SupportTicketHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([supportTicketId, createdAt])
  @@map("support_ticket_history")
}

/// Çalışan konum güncellemeleri geçmişi — her PATCH isteğinde bir satır eklenir.
/// Geçmiş tarih sorgusu: belirli bir tarih için çalışan başına en son kayıt alınır.
model CompanyStatusLog {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  workLocation String   @map("work_location") @db.VarChar(50)
  statusDate   DateTime @map("status_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  employee Calisan @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, statusDate(sort: Desc)])
  @@index([statusDate(sort: Desc)])
  @@map("company_status_logs")
}

/// SHGM (mevzuat.shgm.gov.tr) üzerinden takip edilen mevzuat kaydı — kategori sayfası taranarak bulunur
model ShgmRegulation {
  id                 Int       @id @default(autoincrement())
  title              String    @db.VarChar(500)
  /// sektorel | kurumsal | uluslararasi | kaldirilan
  category           String    @db.VarChar(40)
  /// Mevzuatın listelendiği SHGM kategori sayfası
  sourceUrl          String    @map("source_url") @db.Text
  /// category + title slug — taramalar arası eşleştirme anahtarı
  sourceKey          String    @unique @map("source_key") @db.VarChar(300)
  /// Configurations → Departmanlar ile aynı serbest metin
  department         String?   @db.VarChar(100)
  /// new | reviewed
  status             String    @default("new") @db.VarChar(20)
  publishDate        DateTime? @map("publish_date") @db.Date
  latestRevisionNo   String?   @map("latest_revision_no") @db.VarChar(40)
  latestRevisionDate DateTime? @map("latest_revision_date") @db.Date
  /// Başlık dışı tüm hücrelerin ham metni — kolon anlamı yakalanamasa da değişiklik tespiti için yedek
  latestRawFingerprint String? @map("latest_raw_fingerprint") @db.Text
  /// Kısa AI özeti — işletmeyle ilgisi ve yapılacaklar (best-effort; PDF metni yoksa başlıktan üretilir)
  aiSummary          String?   @map("ai_summary") @db.Text
  aiSummaryUpdatedAt DateTime? @map("ai_summary_updated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  revisions ShgmRegulationRevision[]

  @@index([category])
  @@index([status])
  @@map("shgm_regulations")
}

/// Bir ShgmRegulation için tespit edilen her yeni yayım / revizyon olayının kaydı
model ShgmRegulationRevision {
  id             Int       @id @default(autoincrement())
  regulationId   Int       @map("regulation_id")
  /// created | revised
  kind           String    @db.VarChar(20)
  revisionNo     String?   @map("revision_no") @db.VarChar(40)
  revisionDate   DateTime? @map("revision_date") @db.Date
  pdfStoragePath String?   @map("pdf_storage_path") @db.Text
  pdfFileName    String?   @map("pdf_file_name") @db.VarChar(255)
  sourceUrl      String    @map("source_url") @db.Text
  detectedAt     DateTime  @default(now()) @map("detected_at")
  emailSentAt    DateTime? @map("email_sent_at")

  regulation ShgmRegulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@index([regulationId])
  @@map("shgm_regulation_revisions")
}

/// Kategori için varsayılan sorumlu departman — yeni mevzuat tespit edildiğinde otomatik atanır
model ShgmCategoryDefaultDepartment {
  category   String @id @db.VarChar(40)
  department String @db.VarChar(100)

  @@map("shgm_category_default_departments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Planner — tamamen ayrı, bağımsız bir task management modülü. Mevcut "Görev &
// Aksiyonlar" (/tasks, MeetingTask) modülüyle HİÇBİR FK/relation paylaşmaz —
// MeetingTask'ın toplantı onay workflow'u (Pending Assessment/Review/Revision)
// Planner'ın Trello/Planner-tarzı board+checklist+recurring ihtiyacına uymuyor.
// Sadece User (Calisan) ve Department (isim string, AuditPlanAuditeeDepartment
// ile aynı desen) altyapısı yeniden kullanılır.
//
// Silme davranışı: Plan/Bucket/Task hiçbir zaman HARD DELETE edilmez — yalnızca
// deletedAt (soft delete) işaretlenir. Böylece PlannerTaskHistory asla sessizce
// kaybolmaz (kayıtlar zaten cascade tetiklenmediği için kalıcı kalır).
// ─────────────────────────────────────────────────────────────────────────────

/// Planner çalışma alanı — örn. "Compliance Monitoring", "Safety Management".
model PlannerPlan {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(200)
  description String?   @db.Text
  /// Board üzerinde plan rozetinin rengi (isteğe bağlı, örn. "#2563eb")
  color       String?   @db.VarChar(20)
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Soft delete — dolu ise plan artık aktif değil, hiçbir listede görünmez ama
  /// veritabanında (ve tüm geçmişiyle) kalıcı olarak durur.
  deletedAt   DateTime? @map("deleted_at")

  creator Calisan? @relation("PlannerPlanCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  members PlannerPlanMember[]
  buckets PlannerBucket[]
  tasks   PlannerTask[]

  @@index([deletedAt])
  @@map("planner_plans")
}

/// Plan bazlı erişim/yetki — OWNER/MANAGER plan/bucket/task oluşturabilir, task
/// silebilir, üye ekleyebilir; MEMBER yalnızca kendisine/atandığı departmana
/// atanan task'ları güncelleyebilir. Sunucu tarafında HER ZAMAN uygulanır
/// (bkz. lib/planner-access.ts) — yalnızca UI'da gizlemekle yetinilmez.
model PlannerPlanMember {
  id        Int      @id @default(autoincrement())
  planId    Int      @map("plan_id")
  calisanId Int      @map("calisan_id")
  /// OWNER | MANAGER | MEMBER
  role      String   @default("MEMBER") @db.VarChar(20)
  addedAt   DateTime @default(now()) @map("added_at")

  plan    PlannerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  calisan Calisan     @relation("PlannerPlanMemberCalisan", fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([planId, calisanId])
  @@index([calisanId])
  @@map("planner_plan_members")
}

/// Board kolonu (Short Term, Mid Term, Repetitive, vb. — kullanıcı kendi bucket'ını da oluşturabilir)
model PlannerBucket {
  id        Int       @id @default(autoincrement())
  planId    Int       @map("plan_id")
  name      String    @db.VarChar(200)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  plan  PlannerPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks PlannerTask[]

  @@index([planId])
  @@index([deletedAt])
  @@map("planner_buckets")
}

/// Planner görevi. List/Calendar/Timeline/Charts görünümleri ileride bu şema
/// üzerinde ek tablo gerektirmeden (yalnızca view-layer olarak) eklenebilir —
/// startDate/dueDate/priority/status/bucket zaten mevcut.
model PlannerTask {
  id          Int       @id @default(autoincrement())
  planId      Int       @map("plan_id")
  bucketId    Int       @map("bucket_id")
  title       String    @db.VarChar(500)
  description String?   @db.Text
  /// Board içindeki sırası — kesirli indeks (iki kart arasına eklerken aradaki
  /// değer atanır, diğer kartlara dokunulmaz; sayfa yenilendiğinde sıra korunur).
  sortOrder   Float     @default(0) @map("sort_order")
  /// Not Started | In Progress | Completed | Blocked
  status      String    @default("Not Started") @db.VarChar(30)
  /// Low | Medium | High | Urgent
  priority    String    @default("Medium") @db.VarChar(20)
  /// Labels/Tags — basit string listesi (Postgres text[])
  labels      String[]  @default([])
  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  /// NONE | MONTHLY | QUARTERLY | SEMIANNUAL | YEARLY | CUSTOM
  recurrenceRule         String? @db.VarChar(20) @map("recurrence_rule")
  /// CUSTOM seçildiğinde kaç günde bir tekrarlanacağı
  recurrenceIntervalDays Int?    @map("recurrence_interval_days")
  /// Bu task hangi occurrence'dan üretildi — zincir geriye "previous/original"a
  /// böylece izlenebilir. Tamamlanan occurrence'ın comment/attachment'ları YENİ
  /// occurrence'a KOPYALANMAZ; yalnızca title/description/assignees/bucket/
  /// recurrence ayarları/checklist YAPISI kopyalanır.
  recurrenceParentId Int? @map("recurrence_parent_id")
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Soft delete — silme onay gerektirir (UI) ve PlannerTaskHistory asla kaybolmaz.
  deletedAt   DateTime? @map("deleted_at")

  plan             PlannerPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  bucket            PlannerBucket           @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  creator           Calisan?                @relation("PlannerTaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  recurrenceParent  PlannerTask?            @relation("PlannerTaskRecurrenceChain", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren PlannerTask[]          @relation("PlannerTaskRecurrenceChain")
  assignees         PlannerTaskAssignee[]
  departments       PlannerTaskDepartment[]
  checklistItems    PlannerChecklistItem[]
  comments          PlannerTaskComment[]
  attachments       PlannerTaskAttachment[]
  history           PlannerTaskHistory[]

  @@index([planId])
  @@index([bucketId])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([recurrenceParentId])
  @@map("planner_tasks")
}

/// Bireysel kişi ataması — departman atamasından (PlannerTaskDepartment)
/// BAĞIMSIZ, biri diğerini asla üzerine yazmaz; ikisi birlikte kullanılabilir.
model PlannerTaskAssignee {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  calisanId  Int      @map("calisan_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task    PlannerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  calisan Calisan     @relation("PlannerTaskAssigneeCalisan", fields: [calisanId], references: [id], onDelete: Cascade)

  @@unique([taskId, calisanId])
  @@index([calisanId])
  @@map("planner_task_assignees")
}

/// Departman/Grup ataması — bireysel atamadan bağımsız (AuditPlanAuditeeDepartment
/// ile aynı desen). O departmandaki herhangi bir yetkili kullanıcı task'ı
/// çalışabilir; ancak yaptığı her değişiklik PlannerTaskHistory'de KENDİ
/// kimliğiyle (actorId) kayıt altına alınır — departman adına değil.
model PlannerTaskDepartment {
  id             Int    @id @default(autoincrement())
  taskId         Int    @map("task_id")
  departmentName String @map("department_name") @db.VarChar(100)

  task PlannerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, departmentName])
  @@index([departmentName])
  @@map("planner_task_departments")
}

/// Task içi alt görev / checklist maddesi (örn. "SMS Audit Checklist")
model PlannerChecklistItem {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  label     String   @db.VarChar(500)
  isDone    Boolean  @default(false) @map("is_done")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  task PlannerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("planner_checklist_items")
}

model PlannerTaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  authorId  Int?     @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task   PlannerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Calisan?    @relation("PlannerTaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("planner_task_comments")
}

/// Task ekleri — mevcut direct-to-Supabase güvenli yükleme deseni (Vercel gövde
/// sınırını by-pass eder) ve Finding Files ile aynı güvenli format allow-list'i kullanılır.
model PlannerTaskAttachment {
  id            Int      @id @default(autoincrement())
  taskId        Int      @map("task_id")
  fileName      String   @map("file_name") @db.VarChar(500)
  storagePath   String   @map("storage_path") @db.Text
  mimeType      String?  @map("mime_type") @db.VarChar(200)
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedBy    Int?     @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  task     PlannerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader Calisan?    @relation("PlannerTaskAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("planner_task_attachments")
}

/// Task'a özel kronolojik olay geçmişi — append-only, hiçbir kayıt silinmez.
/// actorId HER ZAMAN işlemi yapan gerçek kullanıcıdır (departman adına yapılan
/// işlemlerde bile) — "hangi departman üyesi ne zaman ne yaptı" izlenebilir kalır.
model PlannerTaskHistory {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  actorId   Int?     @map("actor_id")
  /// CREATED | ASSIGNED | UNASSIGNED | DEPARTMENT_ASSIGNED | DEPARTMENT_UNASSIGNED |
  /// DUE_DATE_CHANGED | MOVED_BUCKET | STATUS_CHANGED | PRIORITY_CHANGED |
  /// CHECKLIST_ITEM_ADDED | CHECKLIST_ITEM_COMPLETED | COMMENT_ADDED |
  /// ATTACHMENT_ADDED | ATTACHMENT_DELETED | COMPLETED | REOPENED | DELETED |
  /// RECURRENCE_CREATED
  eventType String   @db.VarChar(40) @map("event_type")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task  PlannerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor Calisan?    @relation("PlannerTaskHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("planner_task_history")
}
